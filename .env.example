# Copy this file to .env (cp .env.example .env) and fill in your values.
# script.js loads .env automatically on startup; real environment variables always win.

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=1234567890-xxxxxxxxxxxx.apps.googleusercontent.com

# Optional but recommended: long random string used to derive session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Only needed when the frontend is served from a different origin than this
# server (e.g. GitHub Pages + tunnel backend) AND NODE_ENV=production.
# Comma-separated exact origins, no trailing slash:
# CORS_ORIGINS=https://nurtha.dev,https://something.trycloudflare.com
